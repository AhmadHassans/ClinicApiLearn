{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ClinicLearnDb;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Issuer": "ClinicApiLearn",
